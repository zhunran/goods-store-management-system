<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.fengluan</groupId>
        <artifactId>goods-store-management-system-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>goods-store-spi</artifactId>
    <name>goods-store-spi</name>
    <description>服务契约层：各服务对外 Feign 接口、DTO、VO</description>
    <packaging>pom</packaging>

    <modules>
        <module>goods-store-auth-spi</module>
        <module>goods-store-brand-spi</module>
        <module>goods-store-product-spi</module>
        <module>goods-store-member-spi</module>
        <module>goods-store-trade-spi</module>
        <module>goods-store-seckill-spi</module>
    </modules>

    <properties>
        <java.version>25</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>